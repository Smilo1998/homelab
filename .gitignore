# Terraform: local provider/module cache
**/.terraform/*

# Terraform: state files (can contain sensitive values)
*.tfstate
*.tfstate.*

# Terraform: crash logs
crash.log
crash.*.log

# Terraform: variable files (can contain secrets/personal values)
*.tfvars
*.tfvars.json

# Terraform: local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform: CLI config
.terraformrc
terraform.rc

# Saved plan files
*.tfplan

# Environment files
.env
.envrc

# macOS
.DS_Store
